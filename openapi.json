          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "query": { "type": "string" },
                  "topK": { "type": "integer", "default": 5 },
                  "groupIds": {
                    "type": "array",
                    "items": { "type": "string", "format": "uuid" }
                  },
                  "model": { "type": "string", "nullable": true }
                },
                "required": ["query"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Query result with conversation history",
