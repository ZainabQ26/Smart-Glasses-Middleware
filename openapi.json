                "schema": {
                  "type": "object",
                  "properties": {
                    "summary": { "type": "string" },
                    "embeddingGenerated": { "type": "boolean" }
                  }
                }
              }
            }
          },
          "404": { "description": "Conversation not found" }
        }
      }
