    "/metrics": {
      "get": {
        "summary": "Retrieve application metrics and performance statistics",
        "description": "Returns real-time application metrics including request counts, error rates, average response times, and timestamps for each API endpoint. Useful for monitoring system performance and identifying bottlenecks.",
        "tags": ["System"],
        "operationId": "getMetrics",
        "responses": {
          "200": {
            "description": "Application metrics and statistics",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "timestamp": { "type": "string", "format": "date-time" },
                    "endpoints": {
                      "type": "object",
                      "additionalProperties": {
                        "$ref": "#/components/schemas/MetricsSummary"
