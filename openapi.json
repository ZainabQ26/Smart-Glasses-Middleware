{
  "openapi": "3.0.3",
  "info": {
    "title": "Smart Glasses Middleware API",
    "version": "1.0.0"
  },
  "servers": [
    { "url": "http://localhost:5000" }
  ],
  "paths": {
    "/health": {
      "get": {
        "summary": "Health check",
        "responses": { "200": { "description": "OK" } }
      }
    },
    
    "/api/transcribe": {
      "post": {
        "summary": "Transcribe audio",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "file": { "type": "string", "format": "binary", "description": "Binary audio file" }
                }
              },
              "encoding": {
                "file": { "contentType": "audio/*" }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Audio upload result", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AudioUploadResponse" } } } },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": { "$ref": "#/components/schemas/ProblemDetails" },
                "examples": {
                  "validationError": {
                    "summary": "Validation error",
                    "value": {
                      "type": "https://example.com/probs/validation",
                      "title": "Validation Failed",
                      "status": 400,
                      "detail": "One or more fields are invalid.",
                      "instance": "/api/transcribe",
                      "errors": { "audioBase64": [ "Audio data cannot be empty" ] },
                      "requestId": "00000000-0000-0000-0000-000000000000",
                      "timestamp": "2026-01-28T00:00:00Z"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Server Error",
            "content": {
              "application/problem+json": {
                "schema": { "$ref": "#/components/schemas/ProblemDetails" },
                "examples": {
                  "serverError": {
                    "summary": "Internal error",
                    "value": {
                      "type": "about:blank",
                      "title": "Internal Server Error",
                      "status": 500,
                      "detail": "An unexpected error occurred.",
                      "instance": "/api/transcribe",
                      "requestId": "00000000-0000-0000-0000-000000000001",
                      "timestamp": "2026-01-28T00:00:00Z"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/ask": {
      "post": {
        "summary": "Ask AI",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "files": {
                    "type": "string",
                    "format": "binary",
                    "description": "Upload one or more files (client may allow selecting multiple files in the file picker). Allowed extensions: .jpg, .jpeg, .png, .gif, .mp4, .avi, .mov, .wav, .mp3, .m4a, .flac, .aac"
                  },
                  "inputText": { "type": "string", "description": "Plain transcription text (optional)" },
                  "inputFile": { "type": "string", "format": "binary", "description": "Optional transcription file or media file (binary)" },
                  "prompt": { "type": "string" },
                  "perFileTranscriptions": { "type": "string", "description": "JSON object mapping filename->transcription" },
                  "manifest": { "type": "string", "description": "JSON array of filenames to indicate processing order" }
                }
              },
              "encoding": {
                "files": { "contentType": "application/octet-stream" },
                "inputFile": { "contentType": "application/octet-stream" },
                "inputText": { "contentType": "text/plain" },
                "perFileTranscriptions": { "contentType": "text/plain" },
                "manifest": { "contentType": "text/plain" }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Media upload result", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MediaUploadResponse" } } } },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": { "$ref": "#/components/schemas/ProblemDetails" },
                "examples": {
                  "validationError": {
                    "summary": "Manifest/validation error",
                    "value": {
                      "type": "https://example.com/probs/validation",
                      "title": "Validation Failed",
                      "status": 400,
                      "detail": "PerFileTranscriptions contains unknown keys.",
                      "instance": "/api/ask",
                      "errors": { "perFileTranscriptions": [ "Contains keys not present in uploaded files" ] },
                      "requestId": "00000000-0000-0000-0000-000000000002",
                      "timestamp": "2026-01-28T00:00:00Z"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Server Error",
            "content": {
              "application/problem+json": {
                "schema": { "$ref": "#/components/schemas/ProblemDetails" },
                "examples": {
                  "serverError": {
                    "summary": "Internal error",
                    "value": {
                      "type": "about:blank",
                      "title": "Internal Server Error",
                      "status": 500,
                      "detail": "An unexpected error occurred.",
                      "instance": "/api/ask",
                      "requestId": "00000000-0000-0000-0000-000000000003",
                      "timestamp": "2026-01-28T00:00:00Z"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/history": {
      "get": {
        "summary": "Get recent history",
        "parameters": [
          { "name": "count", "in": "query", "schema": { "type": "integer", "default": 10 } }
        ],
        "responses": { "200": { "description": "OK", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/RequestHistory" } } } } } }
      }
    },
    "/api/history/{id}": {
      "get": {
        "summary": "Get history by id",
        "parameters": [ { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } } ],
        "responses": { "200": { "description": "OK", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RequestHistory" } } } }, "404": { "description": "Not Found", "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/ProblemDetails" }, "examples": { "notFound": { "summary": "History not found", "value": { "type": "https://example.com/probs/not-found", "title": "Not Found", "status": 404, "detail": "History entry not found", "instance": "/api/history/{id}", "requestId": "00000000-0000-0000-0000-000000000004", "timestamp": "2026-01-28T00:00:00Z" } } } } } }
      }
    }
  },
  "components": {
    "schemas": {
      "AudioRequest": {
        "type": "object",
        "properties": { "audioBase64": { "type": "string" } },
        "required": ["audioBase64"]
      },
      "AudioUploadResponse": {
        "type": "object",
        "properties": { "storageKey": { "type": "string" }, "transcription": { "type": "string" }, "requestId": { "type": "string", "format": "uuid" } }
      },
      "MediaUploadResponse": {
        "type": "object",
        "properties": {
          "task": { "type": "string" },
          "response": { "type": "string" },
          "usedAdvancedModel": { "type": "boolean" },
          "requestId": { "type": "string", "format": "uuid" },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "fileName": { "type": "string" },
                "contentType": { "type": "string" },
                "storageKey": { "type": "string" },
                "transcription": { "type": "string" }
              }
            }
          }
        }
      },
      "RequestHistory": {
        "type": "object",
        "properties": { "id": { "type": "string", "format": "uuid" }, "requestType": { "type": "string" }, "inputText": { "type": "string" }, "detectedTask": { "type": "string" }, "response": { "type": "string" }, "usedAdvancedModel": { "type": "boolean" }, "mediaStorageKey": { "type": "string" }, "timestamp": { "type": "string", "format": "date-time" } }
      }
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": { "type": "string", "description": "A URI reference that identifies the problem type" },
          "title": { "type": "string", "description": "Short, human-readable summary of the problem type" },
          "status": { "type": "integer", "format": "int32", "description": "HTTP status code" },
          "detail": { "type": "string", "description": "Human-readable explanation specific to this occurrence of the problem" },
          "instance": { "type": "string", "description": "A URI reference that identifies the specific occurrence of the problem" }
        },
        "additionalProperties": true
      }
    }
  }
}