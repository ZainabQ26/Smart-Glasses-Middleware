{
  "openapi": "3.0.3",
  "info": {
    "title": "Smart Glasses Middleware API",
    "version": "1.0.0"
  },
  "servers": [
    { "url": "http://localhost:5000" }
  ],
  "paths": {
    "/health": {
      "get": {
        "summary": "Health check",
        "responses": { "200": { "description": "OK" } }
      }
    },
    
    "/api/audio": {
      "post": {
        "summary": "Upload audio and return transcription",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/AudioRequest" }
            }
          }
        },
        "responses": {
          "200": { "description": "Audio upload result", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AudioUploadResponse" } } } },
          "400": { "description": "Bad Request" },
          "500": { "description": "Server Error" }
        }
      }
    },
    "/api/media": {
      "post": {
        "summary": "Upload media (multipart)",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "file": { "type": "string", "format": "binary" },
                  "prompt": { "type": "string" },
                  "transcription": { "type": "string" }
                },
                "required": ["file"]
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Media upload result", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MediaUploadResponse" } } } },
          "400": { "description": "Bad Request" },
          "500": { "description": "Server Error" }
        }
      }
    },
    "/api/history": {
      "get": {
        "summary": "Get recent history",
        "parameters": [
          { "name": "count", "in": "query", "schema": { "type": "integer", "default": 10 } }
        ],
        "responses": { "200": { "description": "OK", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/RequestHistory" } } } } } }
      }
    },
    "/api/history/{id}": {
      "get": {
        "summary": "Get history by id",
        "parameters": [ { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } } ],
        "responses": { "200": { "description": "OK", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RequestHistory" } } } }, "404": { "description": "Not Found" } }
      }
    }
  },
  "components": {
    "schemas": {
      "AudioRequest": {
        "type": "object",
        "properties": { "audioBase64": { "type": "string" }, "transcription": { "type": "string" } },
        "required": ["audioBase64"]
      },
      "AudioUploadResponse": {
        "type": "object",
        "properties": { "storageKey": { "type": "string" }, "transcription": { "type": "string" }, "requestId": { "type": "string", "format": "uuid" } }
      },
      "MediaUploadResponse": {
        "type": "object",
        "properties": { "task": { "type": "string" }, "response": { "type": "string" }, "usedAdvancedModel": { "type": "boolean" }, "requestId": { "type": "string", "format": "uuid" }, "transcription": { "type": "string" } }
      },
      "RequestHistory": {
        "type": "object",
        "properties": { "id": { "type": "string", "format": "uuid" }, "requestType": { "type": "string" }, "inputText": { "type": "string" }, "detectedTask": { "type": "string" }, "response": { "type": "string" }, "usedAdvancedModel": { "type": "boolean" }, "mediaStorageKey": { "type": "string" }, "timestamp": { "type": "string", "format": "date-time" } }
      }
    }
  }
}
