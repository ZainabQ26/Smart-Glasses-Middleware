    "/api/conversations/{id}/query": {
      "post": {
        "summary": "Query documents with conversation context",
        "tags": ["Conversations"],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
