                "schema": { "$ref": "#/components/schemas/QueryResult" }
              }
            }
          }
        }
      }
    },

    "/api/conversations/{id}/summarize": {
      "post": {
        "summary": "Summarize conversation",
        "tags": ["Conversations"],
