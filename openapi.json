    "/api/admin/files": {
      "get": {
        "summary": "List managed files with pagination",
        "description": "Retrieves a paginated list of all files uploaded through the admin panel. All files returned have been processed through the RAG system for AI searchability. Supports caching for improved performance.",
        "tags": ["Admin"],
        "operationId": "getAdminFiles",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": { "type": "integer", "default": 1, "minimum": 1 },
            "description": "Page number for pagination"
          },
          {
            "name": "pageSize",
            "in": "query",
            "schema": { "type": "integer", "default": 20, "minimum": 1, "maximum": 100 },
            "description": "Number of items per page"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with paginated files",
            "content": {
              "application/json": {
                "examples": {
                  "success": {
                    "summary": "Successful file listing",
                    "value": {
                      "data": [
                        {
                          "id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
                          "fileName": "presentation.pdf",
                          "label": "Q4 Sales Presentation",
                          "contentType": "application/pdf",
                          "storageKey": "admin/2026-01-28/presentation.pdf",
