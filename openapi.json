        "responses": {
          "201": {
            "description": "Conversation created",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Conversation" }
              }
            }
          }
        }
      },
      "get": {
        "summary": "Get all active conversations",
        "tags": ["Conversations"],
        "parameters": [
          {
            "name": "groupId",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "format": "uuid" },
