# API Backend URL (for production builds)
# Leave empty to use same-origin (default for proxied setup)
# Set to full URL if deploying client separately from backend
VITE_API_URL=

# Example production values:
# VITE_API_URL=https://api.yourdomain.com
# VITE_API_URL=https://your-alb.us-east-1.elb.amazonaws.com
