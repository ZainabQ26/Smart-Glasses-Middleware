## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.
##
## Get latest from https://github.com/github/gitignore/blob/master/VisualStudio.gitignore

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Visual Studio cache/options directory
.vs/

# .NET Core
project.lock.json
project.fragment.lock.json
artifacts/

# Files built by Visual Studio
*_i.c
*_p.c
*_h.h
*.ilk
*.meta
*.obj
*.iobj
*.pch
*.pdb
*.ipdb
*.pgc
*.pgd
*.rsp
*.sbr
*.tlb
*.tli
*.tlh
*.tmp
*.tmp_proj
*_wpftmp.csproj
*.log
*.vspscc
*.vssscc
.builds
*.pidb
*.svclog
*.scc

# NuGet Packages
*.nupkg
*.snupkg
**/packages/*
!**/packages/build/
*.nuget.props
*.nuget.targets

# Visual Studio cache files
*.cache

# Others
*.swp
*.swo
*~

# IDE folders
.vscode/
.idea/

# User-specific and local settings
Properties/launchSettings.json
appsettings.Development.json
appsettings.*.Local.json
.env
!.env.example

# Rider
.idea/
*.sln.iml

# Publish output
/publish/

# Certificate files
*.pfx

# OS files
.DS_Store
Thumbs.db

# Secrets directory (if using docker secrets files locally)
secrets/
 
# Ignore test result artifacts and large dumps
tests/**/TestResults/
*.dmp

# Test and temporary files
*.txt
!requirements.txt
*.wav
*.pdf
!*.csproj
regression-results*.txt
*-results.txt
test-*.txt
test_*.txt
*.json
!docs/docfx.json
!package.json
!package-lock.json
!appsettings*.json
!tsconfig*.json
!*.csproj

# LocalStack tokens
.localstack_token*.txt

# AWS and Terraform
*.tfstate
*.tfstate.backup
*.tfstate.lock.info
.terraform/
.terraform.lock.hcl
terraform.tfvars
*.tfvars.json

# Lambda deployment packages
aws/lambda-*/deployment.zip
aws/lambda-*/package/

# LocalStack data
.localstack/

# Ignore client build output to avoid committing generated files that CI will build
# Keep `admin.html` and `monitoring.html` in `wwwroot` tracked; only ignore generated files
/src/SmartGlassesMiddleware/wwwroot/assets/
/src/SmartGlassesMiddleware/wwwroot/index.html
# Silero VAD model files and ONNX Runtime WASM — generated by vite-plugin-static-copy during npm run build (Dockerfile Stage 1)
/src/SmartGlassesMiddleware/wwwroot/silero_vad_legacy.onnx
/src/SmartGlassesMiddleware/wwwroot/silero_vad_v5.onnx
/src/SmartGlassesMiddleware/wwwroot/vad.worklet.bundle.min.js
/src/SmartGlassesMiddleware/wwwroot/ort-wasm-simd-threaded.wasm
/src/SmartGlassesMiddleware/wwwroot/ort-wasm-simd-threaded.asyncify.wasm
/src/SmartGlassesMiddleware/wwwroot/ort-wasm-simd-threaded.jsep.wasm
/src/SmartGlassesMiddleware/wwwroot/ort-wasm-simd-threaded.jspi.wasm

# ORT .mjs companion files (generated by vite-plugin-static-copy during npm run build)
/src/SmartGlassesMiddleware/wwwroot/ort-wasm-simd-threaded*.mjs

# Allow repo-level global.json used to pin the .NET SDK
!/global.json

# DocFX generated site artifacts
/docs/_site/
/docs/api/
/_site/

TestResults/

# Test reports
CoverageReport/
TestResults/
docs/tests/
