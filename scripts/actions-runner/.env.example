# Required: repo URL for runner registration
REPO_URL=https://github.com/robertbiv/Smart-Glasses-Middleware

# Preferred (auto-generated by scripts via gh CLI):
# RUNNER_TOKEN=<short-lived registration token>
#
# Optional fallback: fine-grained PAT with repository administration scope.
# Do not commit real secrets.
ACCESS_TOKEN=
RUNNER_TOKEN=

# Optional: custom runner name prefix
RUNNER_NAME_PREFIX=smart-glasses-local

# Optional: set true for one-job ephemeral runners
EPHEMERAL=false

# Optional: set to true to force runner replacement when name already exists
REPLACE_EXISTING=true
