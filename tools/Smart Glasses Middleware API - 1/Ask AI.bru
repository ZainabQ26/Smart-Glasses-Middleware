meta {
  name: Ask AI
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/ask
  body: multipartForm
  auth: inherit
}

body:multipart-form {
  files: 
  inputText: 
  inputFile: 
  prompt: 
  perFileTranscriptions: 
  manifest: 
}

example {
  name: 200 Response
  description: Media upload result
  
  request: {
    url: {{baseUrl}}/api/ask
    method: POST
    mode: multipartForm
    body:multipart-form: {
      files: 
      inputText: 
      inputFile: 
      prompt: 
      perFileTranscriptions: 
      manifest: 
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "task": "",
          "response": "",
          "usedAdvancedModel": false,
          "requestId": "",
          "items": [
            {
              "fileName": "",
              "contentType": "",
              "storageKey": "",
              "transcription": ""
            }
          ]
        }
      '''
    }
  }
}

example {
  name: Manifest/validation error
  
  request: {
    url: {{baseUrl}}/api/ask
    method: POST
    mode: multipartForm
    body:multipart-form: {
      files: 
      inputText: 
      inputFile: 
      prompt: 
      perFileTranscriptions: 
      manifest: 
    }
  }
  
  response: {
    headers: {
      Content-Type: application/problem+json
    }
  
    status: {
      code: 400
      text: Bad Request
    }
  
    body: {
      type: json
      content: '''
        {
          "type": "https://example.com/probs/validation",
          "title": "Validation Failed",
          "status": 400,
          "detail": "PerFileTranscriptions contains unknown keys.",
          "instance": "/api/ask",
          "errors": {
            "perFileTranscriptions": [
              "Contains keys not present in uploaded files"
            ]
          },
          "requestId": "00000000-0000-0000-0000-000000000002",
          "timestamp": "2026-01-28T00:00:00Z"
        }
      '''
    }
  }
}

example {
  name: Internal error
  
  request: {
    url: {{baseUrl}}/api/ask
    method: POST
    mode: multipartForm
    body:multipart-form: {
      files: 
      inputText: 
      inputFile: 
      prompt: 
      perFileTranscriptions: 
      manifest: 
    }
  }
  
  response: {
    headers: {
      Content-Type: application/problem+json
    }
  
    status: {
      code: 500
      text: Internal Server Error
    }
  
    body: {
      type: json
      content: '''
        {
          "type": "about:blank",
          "title": "Internal Server Error",
          "status": 500,
          "detail": "An unexpected error occurred.",
          "instance": "/api/ask",
          "requestId": "00000000-0000-0000-0000-000000000003",
          "timestamp": "2026-01-28T00:00:00Z"
        }
      '''
    }
  }
}
