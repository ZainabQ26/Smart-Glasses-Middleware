{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "SmartGlassesMiddleware": "Information"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=production-db-host;Database=smartglasses;Username=appuser;Password=production_password_here",
    "Redis": "production-redis-host:6379"
  },
  "MinIO": {
    "Endpoint": "production-minio-host:9000",
    "AccessKey": "production_minio_access_key",
    "SecretKey": "production_minio_secret_key",
    "BucketName": "smart-glasses-media"
  },
  "AI": {
    "OllamaEndpoint": "http://production-ollama-host:11434",
    "OllamaModel": "llama2",
    "AdvancedModelEndpoint": "",
    "AdvancedModelName": "gpt-4",
    "KnownTasks": [ "time", "reminder", "edit-reminder", "delete-reminder", "template" ]
  },
  "Transcription": {
    "Endpoint": "http://production-vosk-host:8080/transcribe"
  },
  "Cors": {
    "AllowedOrigins": [
      "https://your-production-domain.com",
      "https://www.your-production-domain.com"
    ]
  },
  "BackgroundTasks": {
    "RetentionSeconds": 120,
    "CleanupIntervalMinutes": 10
  },
  "ServiceTimeouts": {
    "TranscriptionTimeoutSeconds": 60,
    "AIServiceTimeoutSeconds": 120
  },
  "RateLimiting": {
    "Enabled": true,
    "RequestsPerMinute": 30
  },
  "Metrics": {
    "ApiKey": "production_metrics_api_key_here"
  },
  "RAG": {
    "MaxRetries": 5,
    "RetryDelayMs": 2000,
    "MaxFileSizeMB": 100,
    "BackgroundProcessingIntervalMinutes": 30,
    "MaxContextTokens": 4000,
    "ApproximateTokensPerChar": 0.25,
    "EmbeddingBatchSize": 20,
    "EmbeddingMaxConcurrency": 10,
    "MaxLocalModelTokens": 2000,
    "UseVectorDB": true,
    "VectorSimilarityThreshold": 0.7
  }
}
