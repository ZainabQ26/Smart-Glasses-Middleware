{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "SmartGlassesMiddleware": "Information"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=production-db-host;Database=smartglasses;Username=appuser;Password=MUST_BE_SET_VIA_ENV",
    "Redis": "production-redis-host:6379"
  },
  "MinIO": {
    "Endpoint": "production-minio-host:9000",
    "AccessKey": "MUST_BE_SET_VIA_ENV",
    "SecretKey": "MUST_BE_SET_VIA_ENV",
    "BucketName": "smart-glasses-media"
  },
  "AI": {
    "AdvancedModelEndpoint": "",
    "SpeechTranscriptionMode": "auto",
    "KnownTasks": [ "time", "reminder", "edit-reminder", "delete-reminder", "template", "open-file", "select-document", "document-search", "document-highlight", "document-query", "ocr", "ocr-retry", "next-page", "previous-page", "advanced" ]
  },
  "Cors": {
    "AllowedOrigins": [
      "https://your-production-domain.com",
      "https://www.your-production-domain.com"
    ]
  },
  "BackgroundTasks": {
    "RetentionSeconds": 120,
    "CleanupIntervalMinutes": 10
  },
  "ServiceTimeouts": {
    "TranscriptionTimeoutSeconds": 60,
    "AIServiceTimeoutSeconds": 120
  },
  "RateLimiting": {
    "Enabled": true,
    "RequestsPerMinute": 30
  },
  "Metrics": {
    "ApiKey": "MUST_BE_SET_VIA_ENV"
  },
  "RAG": {
    "MaxRetries": 5,
    "RetryDelayMs": 2000,
    "MaxFileSizeMB": 100,
    "BackgroundProcessingIntervalMinutes": 30,
    "MaxContextTokens": 4000,
    "ApproximateTokensPerChar": 0.25,
    "EmbeddingBatchSize": 20,
    "EmbeddingMaxConcurrency": 10,
    "MaxLocalModelTokens": 2000,
    "UseVectorDB": true,
    "VectorSimilarityThreshold": 0.7
  }
}
