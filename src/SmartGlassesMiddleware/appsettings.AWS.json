{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AWS": {
    "Region": "us-east-1",
    "UseLocalStack": false,
    "S3": {
      "MediaBucket": "",
      "DocumentsBucket": ""
    },
    "Bedrock": {
      "ModelId": "us.amazon.nova-2-lite-v1:0",
      "EmbeddingModelId": "amazon.titan-embed-text-v2:0",
      "EmbeddingDimensions": 1024
    },
    "Transcribe": {
      "LanguageCode": "en-US"
    },
    "Transcription": {
      "WhisperLambdaFunction": "smart-glasses-whisper"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "",
    "Redis": ""
  },
  "MigrateOnStartup": false,
  "Cors": {
    "AllowedOrigins": ["*"]
  },
  "BackgroundTasks": {
    "RetentionSeconds": 60,
    "MaxConcurrency": 4,
    "MaxQueueSize": 1000,
    "CleanupIntervalMinutes": 5
  },
  "ServiceTimeouts": {
    "TranscriptionTimeoutSeconds": 300,
    "AIServiceTimeoutSeconds": 180,
    "MediaBackgroundAiTimeoutSeconds": 5
  },
  "RateLimiting": {
    "Enabled": true,
    "RequestsPerMinute": 60
  },
  "RAG": {
    "MaxFileSizeMB": 50,
    "MaxRetries": 3,
    "RetryDelayMs": 1000,
    "BackgroundProcessingIntervalMinutes": 15,
    "MaxContextTokens": 4000,
    "MaxLocalModelTokens": 2000,
    "ApproximateTokensPerChar": 0.25,
    "EmbeddingBatchSize": 10,
    "EmbeddingMaxConcurrency": 5,
    "UseVectorDB": true,
    "VectorSimilarityThreshold": 0.7,
    "QueryTimeoutSeconds": 180,
    "GatewaySafeQueryTimeoutSeconds": 25
  },
  "AI": {
    "UseAdvancedModel": true,
    "AllowBedrockProcessing": false,
    "SpeechTranscriptionMode": "auto",
    "KnownTasks": [
      "time",
      "reminder",
      "edit-reminder",
      "delete-reminder",
      "template",
      "open-file",
      "select-document",
      "document-search",
      "document-highlight",
      "document-query",
      "ocr",
      "ocr-retry",
      "next-page",
      "previous-page",
      "advanced"
    ]
  }
}
