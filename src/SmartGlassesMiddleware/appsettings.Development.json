{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "RateLimiting": {
    "Enabled": false,
    "RequestsPerMinute": 1000
  },
  "AbbreviationSync": {
    "IntervalDays": 7,
    "OpenFda": {
      "Enabled": true,
      "Limit": 100
    },
    "DailyMed": {
      "Enabled": false,
      "MaxXmlFilesPerSync": 100
    }
  }
  ,"MigrateOnStartup": true
}
