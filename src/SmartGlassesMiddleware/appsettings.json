{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Database=smartglasses;Username=postgres;Password=SET_IN_secrets/postgres_password",
    "Redis": "localhost:6379"
  },
  "MinIO": {
    "Endpoint": "localhost:9000",
    "AccessKey": "SET_IN_secrets/minio_access_key",
    "SecretKey": "SET_IN_secrets/minio_secret_key",
    "BucketName": "smart-glasses-media"
  },
  "AI": {
    "OllamaEndpoint": "http://localhost:11434",
    "OllamaModel": "llama-3.2-3b",
    "AdvancedModelEndpoint": "SET_IN_secrets/ai_advanced_endpoint",
    "AdvancedModelName": "gpt-4"
    ,
    "KnownTasks": [ "time", "reminder", "template" ]
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "https://localhost:3000"
    ]
  }
  ,
  "BackgroundTasks": {
    "RetentionSeconds": 60,
    "CleanupIntervalMinutes": 5
  },
  "ServiceTimeouts": {
    "TranscriptionTimeoutSeconds": 30,
    "AIServiceTimeoutSeconds": 60,
    "AdvancedModelTimeoutSeconds": 120
  },
  "RateLimiting": {
    "Enabled": true,
    "RequestsPerMinute": 60
  },
  "Metrics": {
    "ApiKey": "SET_IN_secrets/metrics_api_key"
  }
}
