{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Database=smartglasses;Username=postgres;Password=postgres",
    "Redis": "localhost:6379"
  },
  "MinIO": {
    "Endpoint": "localhost:9000",
    "AccessKey": "minioadmin",
    "SecretKey": "minioadmin",
    "BucketName": "smart-glasses-media"
  },
  "AI": {
    "OllamaEndpoint": "http://localhost:11434",
    "OllamaModel": "llama-3.2-3b",
    "AdvancedModelEndpoint": "",
    "AdvancedModelName": "gpt-4",
    "KnownTasks": [ "time", "reminder", "edit-reminder", "delete-reminder", "template" ]
  },
  "Transcription": {
    "Endpoint": "http://localhost:8080/transcribe"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "https://localhost:3000"
    ]
  },
  "BackgroundTasks": {
    "RetentionSeconds": 60,
    "CleanupIntervalMinutes": 5
  },
  "ServiceTimeouts": {
    "TranscriptionTimeoutSeconds": 30,
    "AIServiceTimeoutSeconds": 60
  },
  "RateLimiting": {
    "Enabled": true,
    "RequestsPerMinute": 60
  },
  "Metrics": {
    "ApiKey": ""
  },
  "RAG": {
    "MaxRetries": 3,
    "RetryDelayMs": 1000,
    "MaxFileSizeMB": 50,
    "BackgroundProcessingIntervalMinutes": 15,
    "MaxContextTokens": 4000,
    "ApproximateTokensPerChar": 0.25,
    "EmbeddingBatchSize": 10,
    "EmbeddingMaxConcurrency": 5,
    "MaxLocalModelTokens": 2000,
    "UseVectorDB": true,
    "VectorSimilarityThreshold": 0.7,
    "QueryTimeoutSeconds": 120
  }
}
