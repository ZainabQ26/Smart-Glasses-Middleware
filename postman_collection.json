{
  "info": {
    "name": "Smart-Glasses-Middleware API",
    "_postman_id": "",
    "description": "Postman collection for the Smart Glasses Middleware API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "version": "1.0.0"
  },
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": ["{{baseUrl}}"],
          "path": ["health"]
        }
      }
    },
    
    {
      "name": "Process Audio",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"audioBase64\": \"<base64-audio>\",\n  \"transcription\": \"optional transcription text\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/api/audio", "host": ["{{baseUrl}}"], "path": ["api","audio"] }
      }
    },
    {
      "name": "Process Media (file upload)",
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "formdata",
          "formdata": [
            { "key": "file", "type": "file", "src": "" },
            { "key": "prompt", "type": "text", "value": "Describe this image" },
            { "key": "transcription", "type": "text", "value": "optional transcription" }
          ]
        },
        "url": { "raw": "{{baseUrl}}/api/media", "host": ["{{baseUrl}}"], "path": ["api","media"] }
      }
    },
    {
      "name": "Get Recent History",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/history?count=10",
          "host": ["{{baseUrl}}"],
          "path": ["api","history"],
          "query": [ { "key": "count", "value": "10" } ]
        }
      }
    },
    {
      "name": "Get History By ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/history/{{requestId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api","history","{{requestId}}"]
        }
      }
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000", "type": "string" },
    { "key": "requestId", "value": "", "type": "string" }
  ]
}
