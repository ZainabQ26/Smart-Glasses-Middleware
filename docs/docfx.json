{
  "metadata": [
    {
      "src": [
        {
          "src": "..",
          "files": [
            "src/SmartGlassesMiddleware/SmartGlassesMiddleware.csproj"
          ]
        }
      ],
      "dest": "api"
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "api/**.yml",
          "api/index.md"
        ]
      },
      {
        "files": [
          "*.md",
          "toc.yml"
        ]
      },
      {
        "src": "..",
        "files": [
          "README.md"
        ]
      }
    ],
    "resource": [
      {
        "src": "..",
        "files": [
          "openapi.json"
        ]
      },
      {
        "files": [
          "swagger/index.html"
        ]
      },
      {
        "files": [
          "public/main.css"
        ]
      },
      {
        "files": [
          "tests/**"
        ]
      }
    ],
    "output": "_site",
    "template": [
      "default",
      "modern"
    ],
    "globalMetadata": {
      "_appTitle": "Smart Glasses Middleware Docs",
      "_appName": "Smart Glasses Middleware",
      "_enableSearch": true,
      "_customCss": [
        "public/main.css"
      ]
    }
  }
}
