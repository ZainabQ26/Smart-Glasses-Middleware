# Smart Glasses Middleware - AWS LocalStack Configuration
# Copy this file to .env and replace the placeholder values with your actual configuration
#
# SECURITY WARNING: 
# - Never commit the .env file to version control
# - Change all default passwords before deploying to production
# - Use strong, unique passwords for all services

# ==============================================================================
# ENVIRONMENT
# ==============================================================================
ASPNETCORE_ENVIRONMENT=Development

# ==============================================================================
# AWS CONFIGURATION
# ==============================================================================
# For LocalStack development
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_ENDPOINT_URL=http://localhost:4566

# For production AWS, set these to your actual credentials
# AWS_ACCESS_KEY_ID=your_actual_key_id
# AWS_SECRET_ACCESS_KEY=your_actual_secret_key

# ==============================================================================
# DATABASE CONFIGURATION (PostgreSQL with pgvector)
# ==============================================================================
POSTGRES_DB=smartglasses
POSTGRES_USER=postgres
# SECURITY: Change this password in production!
POSTGRES_PASSWORD=postgres

# For LocalStack docker-compose: use service name "postgres"
# For production: use RDS endpoint
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ==============================================================================
# REDIS CONFIGURATION
# ==============================================================================
# For LocalStack docker-compose: use service name "redis"
# For production: use ElastiCache endpoint
REDIS_HOST=redis
REDIS_PORT=6379

# ==============================================================================
# AWS S3 CONFIGURATION
# ==============================================================================
# S3 Buckets
S3_MEDIA_BUCKET=smart-glasses-dev-media
S3_DOCUMENTS_BUCKET=smart-glasses-dev-documents
S3_FRONTEND_BUCKET=smart-glasses-dev-frontend

# ==============================================================================
# AWS BEDROCK (AI MODEL) CONFIGURATION
# ==============================================================================
# Bedrock Model IDs
BEDROCK_MODEL_ID=anthropic.claude-v2
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v1

# For LocalStack, this points to the mock endpoint
# For production, leave empty to use default AWS Bedrock endpoint
BEDROCK_ENDPOINT=http://localhost:4566

# ==============================================================================
# AWS SECRETS MANAGER
# ==============================================================================
# Secret names for Secrets Manager
SECRET_DB_CREDENTIALS=smart-glasses-dev-db-credentials
SECRET_REDIS_CREDENTIALS=smart-glasses-dev-redis-credentials
SECRET_APP_SECRETS=smart-glasses-dev-app-secrets

# ==============================================================================
# LOCALSTACK CONFIGURATION
# ==============================================================================
# Set to true when using LocalStack for development
USE_LOCALSTACK=true

# LocalStack Auth Token (for LocalStack Pro features)
# Leave empty for LocalStack Community Edition
LOCALSTACK_AUTH_TOKEN=

# ==============================================================================
# DATABASE MIGRATIONS
# ==============================================================================
# If true, the application will attempt to apply pending EF Core migrations on startup.
# Set to 'true' in development to auto-initialize the database.
# In production, consider managing migrations explicitly.
MIGRATE_ON_STARTUP=true

# ==============================================================================
# CORS CONFIGURATION
# ==============================================================================
# Allowed Origins (comma-separated list)
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://localhost:3000

# ==============================================================================
# BACKGROUND TASKS CONFIGURATION
# ==============================================================================
# How long to retain completed background tasks (in seconds)
BACKGROUND_TASKS_RETENTION_SECONDS=60

# Maximum concurrent background tasks
BACKGROUND_TASKS_MAX_CONCURRENCY=4

# How often to run cleanup of old background tasks (in minutes)
BACKGROUND_TASKS_CLEANUP_INTERVAL_MINUTES=5

# ==============================================================================
# SERVICE TIMEOUTS CONFIGURATION
# ==============================================================================
# Timeout for AI service calls (in seconds)
AI_SERVICE_TIMEOUT_SECONDS=180

# Timeout for media background AI processing (in seconds)
MEDIA_BACKGROUND_AI_TIMEOUT_SECONDS=5

# ==============================================================================
# RATE LIMITING CONFIGURATION
# ==============================================================================
# Enable or disable rate limiting
RATE_LIMITING_ENABLED=false

# Maximum requests per minute per user/IP
RATE_LIMITING_REQUESTS_PER_MINUTE=1000

# ==============================================================================
# METRICS CONFIGURATION
# ==============================================================================
# API Key for accessing the /metrics endpoint
# Leave empty to disable metrics endpoint protection in development
METRICS_API_KEY=

# ==============================================================================
# RAG (Retrieval-Augmented Generation) CONFIGURATION
# ==============================================================================
# Maximum file size for document uploads (in MB)
RAG_MAX_FILE_SIZE_MB=50

# Maximum retries for document processing
RAG_MAX_RETRIES=3

# Retry delay for document processing (in milliseconds)
RAG_RETRY_DELAY_MS=1000

# Background processing interval for documents (in minutes)
RAG_BACKGROUND_PROCESSING_INTERVAL_MINUTES=15

# Maximum context tokens for AI processing
RAG_MAX_CONTEXT_TOKENS=4000

# Maximum tokens for local model processing
RAG_MAX_LOCAL_MODEL_TOKENS=2000

# Approximate tokens per character (for estimation)
RAG_APPROXIMATE_TOKENS_PER_CHAR=0.25

# Batch size for embedding generation
RAG_EMBEDDING_BATCH_SIZE=10

# Maximum concurrent embedding operations
RAG_EMBEDDING_MAX_CONCURRENCY=5

# Use vector database for similarity search
RAG_USE_VECTOR_DB=true

# Similarity threshold for vector search (0.0 to 1.0)
RAG_VECTOR_SIMILARITY_THRESHOLD=0.7

# Query timeout for RAG operations (in seconds)
RAG_QUERY_TIMEOUT_SECONDS=180

# ==============================================================================
# LOGGING CONFIGURATION
# ==============================================================================
# Log Level (Options: Trace, Debug, Information, Warning, Error, Critical)
LOG_LEVEL_DEFAULT=Information
LOG_LEVEL_ASPNETCORE=Warning
LOG_LEVEL_APP=Information
