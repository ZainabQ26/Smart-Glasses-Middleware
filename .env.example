# Smart Glasses Middleware - Environment Configuration
# Copy this file to .env and replace the placeholder values with your actual configuration
#
# SECURITY WARNING: 
# - Never commit the .env file to version control
# - Change all default passwords before deploying to production
# - Use strong, unique passwords for all services

# ==============================================================================
# ENVIRONMENT
# ==============================================================================
ASPNETCORE_ENVIRONMENT=Development

# ==============================================================================
# DATABASE CONFIGURATION
# ==============================================================================
# PostgreSQL Connection
POSTGRES_DB=smartglasses
POSTGRES_USER=postgres
# SECURITY: Change this password! Default 'postgres' is insecure.
POSTGRES_PASSWORD=your_secure_postgres_password_here

# PostgreSQL Host (for application connection)
# For docker-compose: use service name "postgres"
# For local development: use "localhost"
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Host path or named volume to persist Postgres data.
# - Use a host absolute path (Windows: C:/path/to/dir) to bind-mount a host folder
# - Use a named volume like 'postgres-data' to let Docker manage it
POSTGRES_DATA_VOLUME=postgres-data

# ==============================================================================
# REDIS CONFIGURATION
# ==============================================================================
# Redis Host and Port
# For docker-compose: use service name "redis"
# For local development: use "localhost"
REDIS_HOST=redis
REDIS_PORT=6379

# ==============================================================================
# MINIO (S3-Compatible Storage) CONFIGURATION
# ==============================================================================
# MinIO Endpoint
# For docker-compose: use service name "minio"
# For local development: use "localhost"
MINIO_ENDPOINT=minio:9000
# SECURITY: Change these default credentials!
# Default values (minioadmin/minioadmin123) are for development only
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET_NAME=smart-glasses-media
# Host path or named volume to persist MinIO data (object store).
MINIO_DATA_VOLUME=minio-data

# ==============================================================================
# AI MODEL CONFIGURATION
# ==============================================================================
# Ollama (Local AI Model) Endpoint
# For docker-compose: use service name "ollama"
# For local development: use "localhost"
OLLAMA_ENDPOINT=http://ollama:11434
OLLAMA_MODEL=llama-3.2-3b
# Host path or named volume to persist Ollama data (models, state).
OLLAMA_DATA_VOLUME=ollama-data

# Advanced AI Model Endpoint (e.g., GPT-4 or other API)
# Leave empty if not using an advanced model
AI_ADVANCED_ENDPOINT=http://localhost:5000/api/chat
AI_ADVANCED_MODEL_NAME=gpt-4

# Known Task Types (comma-separated list)
AI_KNOWN_TASKS=time,reminder,edit-reminder,delete-reminder,template

# ==============================================================================
# TRANSCRIPTION SERVICE CONFIGURATION
# ==============================================================================
# Transcription Service Endpoint
# For docker-compose: use service name "vosk-transcriber"
# For local development: configure your local transcription service
TRANSCRIPTION_ENDPOINT=http://vosk-transcriber:8080

# If true, the application will attempt to apply pending EF Core migrations on startup.
# Set to 'true' in development to auto-initialize the database. In production, consider
# managing migrations explicitly.
MIGRATE_ON_STARTUP=true

# Vosk Model Configuration (for transcription service)
VOSK_MODEL_NAME=vosk-model-small-en-us-0.15
VOSK_MODEL_URL=https://alphacephei.com/vosk/models/vosk-model-small-en-us-0.15.zip

# Host path or named volume for Vosk models folder used by the transcription service.
VOSK_MODELS_VOLUME=models

# ==============================================================================
# CORS CONFIGURATION
# ==============================================================================
# Allowed Origins (comma-separated list)
# In development, CORS is permissive by default
# In production, only specified origins are allowed
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://localhost:3000

# ==============================================================================
# BACKGROUND TASKS CONFIGURATION
# ==============================================================================
# How long to retain completed background tasks (in seconds)
BACKGROUND_TASKS_RETENTION_SECONDS=60

# How often to run cleanup of old background tasks (in minutes)
BACKGROUND_TASKS_CLEANUP_INTERVAL_MINUTES=5

# ==============================================================================
# SERVICE TIMEOUTS CONFIGURATION
# ==============================================================================
# Timeout for transcription service calls (in seconds)
TRANSCRIPTION_TIMEOUT_SECONDS=30

# Timeout for AI service calls (in seconds)
AI_SERVICE_TIMEOUT_SECONDS=60

# ==============================================================================
# RATE LIMITING CONFIGURATION
# ==============================================================================
# Enable or disable rate limiting
RATE_LIMITING_ENABLED=true

# Maximum requests per minute per user/IP
RATE_LIMITING_REQUESTS_PER_MINUTE=60

# ==============================================================================
# METRICS CONFIGURATION
# ==============================================================================
# API Key for accessing the /metrics endpoint
# Leave empty to disable metrics endpoint protection in development
# In production, this should be set to restrict access
METRICS_API_KEY=

# ==============================================================================
# RAG (Retrieval-Augmented Generation) CONFIGURATION
# ==============================================================================
# Maximum file size for document uploads (in MB)
RAG_MAX_FILE_SIZE_MB=50

# Maximum retries for document processing
RAG_MAX_RETRIES=3

# Retry delay for document processing (in milliseconds)
RAG_RETRY_DELAY_MS=1000

# Background processing interval for documents (in minutes)
RAG_BACKGROUND_PROCESSING_INTERVAL_MINUTES=15

# Maximum context tokens for AI processing
RAG_MAX_CONTEXT_TOKENS=4000

# Maximum tokens for local model processing
RAG_MAX_LOCAL_MODEL_TOKENS=2000

# Approximate tokens per character (for estimation)
RAG_APPROXIMATE_TOKENS_PER_CHAR=0.25

# Batch size for embedding generation
RAG_EMBEDDING_BATCH_SIZE=10

# Maximum concurrent embedding operations
RAG_EMBEDDING_MAX_CONCURRENCY=5

# Use vector database for similarity search
RAG_USE_VECTOR_DB=true

# Similarity threshold for vector search (0.0 to 1.0)
RAG_VECTOR_SIMILARITY_THRESHOLD=0.7

# ==============================================================================
# LOGGING CONFIGURATION
# ==============================================================================
# Log Level (Options: Trace, Debug, Information, Warning, Error, Critical)
LOG_LEVEL_DEFAULT=Information
LOG_LEVEL_ASPNETCORE=Warning
LOG_LEVEL_APP=Information
